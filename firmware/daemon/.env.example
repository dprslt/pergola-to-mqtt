# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never carry a real value.
#
# Every name is prefixed PERGOLA_ so an unrelated MQTT_HOST exported for some
# other tool cannot quietly flash the wrong broker into the pergola.
#
# Anything exported in your shell overrides the value here, which is what makes
# a one-off `PERGOLA_MQTT_HOST=10.0.0.5 pio run -t upload` work.

PERGOLA_WIFI_SSID=your-ssid
PERGOLA_WIFI_PASSWORD=your-wifi-passphrase

# The broker. Host may be an IP or a name the ESP32 can resolve -- note that
# .local mDNS names do not resolve from the ESP32 without extra work, so prefer
# the IP.
PERGOLA_MQTT_HOST=192.168.1.10
PERGOLA_MQTT_PORT=1883

# Leave both empty for an anonymous broker.
PERGOLA_MQTT_USER=
PERGOLA_MQTT_PASSWORD=

# Over-the-air update password. Leave it empty and OTA is not started at all:
# an unauthenticated flash endpoint on a device that moves a heavy roof is worse
# than having to fetch a USB cable.
#
# Use letters and digits only. A '$' here is refused by inject_secrets.py, because
# SCons expands it inside the upload flags and espota would fail to authenticate
# with no useful error.
#
# Once set and flashed once over USB, later uploads go over the air with no
# password on the command line:
#
#   .venv/bin/pio run -d firmware/daemon -e esp32dev-ota -t upload
PERGOLA_OTA_PASSWORD=
